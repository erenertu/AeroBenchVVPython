import os  # noqa: I001
import time
import math
import sys
import copy
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import jsbsim
from jsbsim import FGFDMExec

tmax = 60
FT_TO_M = 0.3048

# Modify run_jsbsim_simulation to include the new parameters
def run_jsbsim_simulation():
    IC_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "init_cond.xml")
    ROOT_DIR = os.path.dirname(jsbsim.__file__)

    # Initial config
    aircraft_name = "c172p"
    sim_freq_hz = 200

    sim = FGFDMExec(root_dir=ROOT_DIR)
    sim.load_ic(IC_PATH, False)
    sim.load_model(aircraft_name)
    sim.set_dt(1 / sim_freq_hz)

    success = sim.run_ic()
    if not success:
        raise RuntimeError("JSBSim failed to init simulation conditions.")

    data = []
    comp_time = []
    runtime = 0

    while runtime < tmax:
        loop_start_time = time.perf_counter_ns()
        sim["fcs/throttle-cmd-norm"] = float(0.1)
        sim.run()

        # Get the required outputs and add the new parameters
        outputs = [
            sim["aero/alpha-deg"],
            sim["aero/beta-deg"],
            sim["velocities/vg-fps"] * FT_TO_M,
            sim["velocities/q-rad_sec"] * 180 / math.pi,
            sim["velocities/p-rad_sec"] * 180 / math.pi,
            sim["velocities/r-rad_sec"] * 180 / math.pi,
            sim["attitude/phi-rad"] * 180 / math.pi,   # Roll (Phi) in degrees
            sim["attitude/pitch-rad"] * 180 / math.pi, # Pitch in degrees
            sim["attitude/psi-rad"] * 180 / math.pi    # Yaw (Psi) in degrees
        ]
        data.append(outputs)

        runtime += 1/sim_freq_hz
        fps_recorder = (time.perf_counter_ns() - loop_start_time)
        comp_time.append(fps_recorder)

    return np.arange(0, tmax, 1/200), data, comp_time


# Run the simulation
time_jsbsim, data_jsbsim, comp_time_jsbsim = run_jsbsim_simulation()
data_jsbsim = np.array(data_jsbsim)

# Check for NaN values in each parameter
parameters = ['Alpha', 'Beta', 'Airspeed', 'Pitch Rate (q)', 'Roll Rate (p)', 'Yaw Rate (r)', 'Roll (Phi)', 'Pitch (Theta)', 'Yaw (Psi)']
for i, param in enumerate(parameters):
    nan_count = np.isnan(data_jsbsim[:, i]).sum()
    if nan_count > 0:
        print(f"{param} has {nan_count} NaN values.")
